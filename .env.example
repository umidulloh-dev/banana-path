# PostgreSQL connection string.
# Local docker-compose default; Railway injects its own value.
DATABASE_URL=postgresql://banana:banana@localhost:5432/banana_path?schema=public

# Anthropic API credentials. Server-side only — never expose to the browser.
ANTHROPIC_API_KEY=sk-ant-...
# Model used for lesson generation, code review and the mentor chat.
ANTHROPIC_MODEL=claude-opus-5
# Upper bound for a single completion. Lesson generation needs room: a lower
# value truncates the JSON mid-answer. Requests stream, so only generated
# tokens are billed, not the ceiling.
ANTHROPIC_MAX_TOKENS=48000
# Thinking depth / token spend: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Single shared password that unlocks the site.
APP_PASSWORD=change-me
# Secret used to sign the session JWT (at least 16 characters).
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port.
PORT=3000

# Optional overrides
# Absolute path to the folder holding index.html (defaults to ../public).
# PUBLIC_DIR=/app/public
# AI rate limit: how many requests per window, and the window length in ms.
# AI_RATE_LIMIT=30
# AI_RATE_WINDOW_MS=600000
# How long a generated lesson stays cached, in ms (24h by default).
# LESSON_CACHE_TTL_MS=86400000
